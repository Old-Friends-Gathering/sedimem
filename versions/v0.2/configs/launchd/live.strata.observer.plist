<?xml version="1.0" encoding="UTF-8"?>
<!--
  本地常驻观察台（macOS launchd）。

  用法：
    1) 把下面三处 __占位符__ 换成你机器上的真实路径：
         __NODE__       node 绝对路径（建议用 DSH 自带 runtime 的 node，>=22）
         __REPO_ROOT__  本仓库根目录
         __MEMO_HOME__  记忆库目录，通常是 $HOME/.memo
    2) cp versions/v0.2/configs/launchd/live.strata.observer.plist ~/Library/LaunchAgents/
       launchctl load ~/Library/LaunchAgents/live.strata.observer.plist
    3) 打开 http://127.0.0.1:7788

  KeepAlive=true：进程挂了自动拉起来；RunAtLoad=true：登录即启动。
  改了代码想让它加载新版本，用：
       launchctl kickstart -k gui/$(id -u)/live.strata.observer
  （直接 kill 也行，KeepAlive 会重起，但 kickstart 更明确。）
-->
<plist version="1.0">
<dict>
  <key>Label</key><string>live.strata.observer</string>
  <key>ProgramArguments</key>
  <array>
    <string>__NODE__</string>
    <string>__REPO_ROOT__/versions/v0.2/src/cli/memo.js</string>
    <string>serve</string>
    <string>--port</string>
    <string>7788</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>MEMO_HOME</key><string>__MEMO_HOME__</string>
    <key>PATH</key><string>/usr/local/bin:/usr/bin:/bin:/opt/homebrew/bin</string>
  </dict>
  <key>WorkingDirectory</key><string>__REPO_ROOT__</string>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>StandardOutPath</key><string>__MEMO_HOME__/serve.log</string>
  <key>StandardErrorPath</key><string>__MEMO_HOME__/serve.err.log</string>
</dict>
</plist>
