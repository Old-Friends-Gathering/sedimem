<?xml version="1.0" encoding="UTF-8"?>
<!--
  本地常驻观察台（macOS launchd）。

  它不直接调 CLI，而是调 scripts/strata-run.sh —— 那个脚本读 versions/CURRENT 决定跑哪个版本目录。
  换大版本（v0.2 → v0.3）时这个 plist 不用改，这正是 issue #47 要防的事：
  旧机器的 crontab 写死了 versions/v0.1，版本切换后 nightly 一直在跑冻结代码。

  用法：
    1) 把两处占位符换成真实路径：__REPO_ROOT__（本仓库根）/ __MEMO_HOME__（通常 $HOME/.memo）
    2) cp 到 ~/Library/LaunchAgents/ && launchctl load ~/Library/LaunchAgents/live.strata.observer.plist
    3) 打开 http://127.0.0.1:7788
  改了代码要它加载新版本：launchctl kickstart -k gui/$(id -u)/live.strata.observer
-->
<plist version="1.0">
<dict>
  <key>Label</key><string>live.strata.observer</string>
  <key>ProgramArguments</key>
  <array>
    <string>__REPO_ROOT__/scripts/strata-run.sh</string>
    <string>serve</string>
    <string>--port</string>
    <string>7788</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>MEMO_HOME</key><string>__MEMO_HOME__</string>
    <key>MEMO_NODE</key><string>__NODE__</string>
    <key>PATH</key><string>/usr/local/bin:/usr/bin:/bin:/opt/homebrew/bin</string>
  </dict>
  <key>WorkingDirectory</key><string>__REPO_ROOT__</string>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>StandardOutPath</key><string>__MEMO_HOME__/serve.log</string>
  <key>StandardErrorPath</key><string>__MEMO_HOME__/serve.err.log</string>
</dict>
</plist>
