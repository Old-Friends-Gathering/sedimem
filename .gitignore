# 运行时数据（记忆本体不在仓库里）
.memo/
*.log

# 依赖与构建产物
node_modules/
dist/

# 编辑器 / 操作系统
.DS_Store
.idea/
.vscode/
*.swp

# 评测临时输出（LATEST 保留，历史快照按需提交）
versions/*/eval/results/tmp-*

# 本地密钥/环境变量（永不入库）
.env
.env.*

# 防止 shell 重定向/临时输出误入仓库（2026-11-14 事故：#145 混入 versions/v0.6/mcp===）
*===
*.tmp-*

# 打包产物（图卡/文案导出）不入库
*.zip
