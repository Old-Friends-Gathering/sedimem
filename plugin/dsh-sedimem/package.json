{
  "name": "dsh-sedimem",
  "version": "0.1.0",
  "description": "sedimem 记忆中心：DSH 侧边栏一键打开只读观察台（今日 / 图谱 / 卫生），内嵌 observer，零运行时依赖。",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "icon.svg",
    "README.md"
  ],
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js"
  },
  "dsh": {
    "engines": {
      "dsh": ">=0.2.1-rc.2"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-layout"
      ],
      "platform": "web"
    }
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "memory",
    "mcp"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Old-Friends-Gathering/sedimem.git",
    "directory": "plugin/dsh-sedimem"
  }
}
